# mysql 模块 —— 服务器配置（烘进镜像；官方主配置里有 `!includedir /etc/mysql/conf.d/`）
[mysqld]
character-set-server = utf8mb4
# 必须显式指定：8.0 的默认排序规则是 utf8mb4_0900_ai_ci，而建库脚本里写的是
# utf8mb4_general_ci —— 不锁定就会出现"同一个库、不同连接排序结果不同"这类难查的问题。
collation-server     = utf8mb4_general_ci
# 采集/转存是并发写入（转存线程池），连接数与包大小留宽一点
max_connections      = 200
max_allowed_packet   = 32M

# 认证插件：8.0 默认 caching_sha2_password（比 mysql_native_password 安全）。
# PyMySQL 连它需要 `cryptography` —— 已写进 crawler/api 的依赖清单，无需额外配置。
# ⚠️ 宿主机上的旧客户端（老版 Navicat / 老 mysql CLI）可能不认识这个插件，
#    升级客户端即可；不要在服务端退回 mysql_native_password（8.4 已移除该插件）。

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
