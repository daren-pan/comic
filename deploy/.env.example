# 复制为 deploy/.env 后修改：  cp deploy/.env.example deploy/.env
# ⚠️ deploy/.env 已被 .gitignore 忽略 —— 不要提交到仓库

# ---------- 必改（2 项）----------
# 数据库 root 口令：本项目**独占**的 comic-mysql 实例用它初始化。
# 默认 `password`（简单口令 + **靠网络层限制来源**：云安全组 / 防火墙只放行需要的来源）。
# 若数据库端口要对公网开放，务必换成强随机值（生成：python -c "import secrets; print(secrets.token_urlsafe(24))"）。
# ⚠️ 只在数据卷首次创建时生效；之后改这里不会同步到已建好的库
#    （要改：进容器 ALTER USER，或 `docker compose down -v` 重置卷 —— 后者会清库）。
MYSQL_ROOT_PASSWORD=password
# JWT 签名密钥：必须换成强随机值，否则登录态可被伪造
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
COMIC_JWT_SECRET=change-me-to-a-random-48-bytes

# ---------- 可选（有默认值）----------
# 两个前端入口各自的宿主端口（两个入口是**独立的容器 + 独立的端口**，可同时开）：
#   网页端 comic-web   → WEB_PORT   （默认 85）
#   移动端 comic-front → FRONT_PORT （默认 86）
# 想只开其中一个就 `docker compose up -d comic-front`（或 comic-web）；端口占用就改这里。
WEB_PORT=85
FRONT_PORT=86
# 数据库的宿主端口（给 Navicat/IDEA 从本机连用，默认 3309 —— 避开其它系统常用的 3307）
MYSQL_HOST_PORT=3309
# 只允许本机连数据库就设 127.0.0.1；默认 0.0.0.0（局域网可连）
MYSQL_BIND=0.0.0.0
COMIC_MYSQL_DB=comic
# 容器时区（app / scheduler / mysql 共用）。**别删**：镜像默认 UTC，而程序里所有"当前时间"
# 都按本机时间入库（日志、sync_time），不设会让管理台日志时间比北京时间早 8 小时。
# 只在服务器时区不是东八区、且你希望按服务器本地时间记账时才改（如 Asia/Tokyo）。
COMIC_TZ=Asia/Shanghai
# 容器的运行时数据目录（图库 + 数据源开关）bind 到哪个宿主目录。
# 留空 = ../crawler-service/data（仓库内；**与本地直跑的默认值是同一个目录**，两侧共用同一份）。
# 服务器请指向**仓库外的独立盘**，例如 /srv/comic/data —— 别放仓库里，重新 clone / 部署会丢。
# ⚠️ 目录需可写：容器内进程是 uid 10001（sudo chown -R 10001:10001 /srv/comic/data）。
#COMIC_DATA_HOST=/srv/comic/data
# 定时采集的巡检间隔（秒）—— 仅在使用 --profile collect 启动 scheduler 时生效
COLLECT_INTERVAL=900

# ---------- 仅在"要连别的 MySQL"时才需要（不推荐，会与其它系统共库）----------
# 默认 comic-app 走编排内网连本项目自己的 comic-mysql:3306。要改连外部库就打开这三行，
# 并给 compose 里的 app/scheduler 加回 extra_hosts: ["host.docker.internal:host-gateway"]
#COMIC_MYSQL_HOST=host.docker.internal
#COMIC_MYSQL_PORT=<目标 MySQL 的宿主端口>
#COMIC_MYSQL_PASSWORD=
