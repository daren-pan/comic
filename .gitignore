# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- Node ----
node_modules/

# ---- 前端构建产物（由 comic-web/src 经 vite build 生成，不入库，clone 后需先构建）----
dist/
*/dist/

# ---- 打包产物（scripts/package.* 按需生成部署包，不入库）----
build/

# ---- 本地数据库（不在仓库中分发，需联网采集或手动导入重建） ----
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---- 图库（采集/转存产物，可联网重新抓取，不随仓库分发） ----
image_store/
*/image_store/

# ---- 运行时产物 / 日志（统一收在根 logs/，仅保留占位文件）----
serve_out.txt
nohup.out
*.log
logs/*
!logs/.gitkeep
source_state.json

# ---- 数据库备份（含业务数据，仅供本地回滚，不随仓库分发） ----
backup/

# ---- 开发/探测残留（不随仓库分发） ----
_zmh_probe/
.workbuddy/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
