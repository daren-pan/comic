# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- Node ----
node_modules/

# ---- 前端构建产物（由 comic-web/src 经 vite build 生成，不入库，clone 后需先构建）----
dist/
*/dist/

# ---- uni-app 构建产物（comic-front 各端打包输出 dist/{build,dev}/<平台>，已由上面的 dist/ 规则覆盖）----
#   例：comic-front/dist/build/h5（H5 发布）、comic-front/dist/dev/mp-weixin（小程序开发）

# ---- 打包产物（scripts/package.* 按需生成部署包，不入库）----
build/

# ---- 本地数据库（不在仓库中分发，需联网采集或手动导入重建） ----
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---- 图库（采集/转存产物，可联网重新抓取，不随仓库分发） ----
image_store/
*/image_store/

# ---- 运行时产物 / 日志（统一收在根 logs/，仅保留占位文件）----
serve_out.txt
nohup.out
*.log
logs/*
!logs/.gitkeep
source_state.json

# ---- 数据库备份（含业务数据，仅供本地回滚，不随仓库分发） ----
backup/

# ---- 开发/探测残留（不随仓库分发） ----
_zmh_probe/

# ---- AI 协作配置 .workbuddy/（默认忽略）----
# 入库共享：skills/ 全目录 + memory/MEMORY.md；日志（memory/*.md）仍忽略
.workbuddy/*
!.workbuddy/skills/
!.workbuddy/memory/
.workbuddy/memory/*
!.workbuddy/memory/MEMORY.md

# ---- 部署配置（含密钥，只入库示例文件）----
deploy/.env

# ---- 部署产物（由 deploy/build.sh 生成，不入库）----
#   crawler/api = 构建出的 wheel；web = 前端 dist 的复制品
deploy/api/dist/
deploy/crawler/dist/
deploy/mysql/sql/
deploy/web/dist/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
